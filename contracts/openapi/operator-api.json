      "ApiError" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "currentVersion" : {
            "type" : "string"
          },
          "fieldErrors" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            },
            "type" : "array"
          },
          "message" : {
            "type" : "string"
          },
          "requestId" : {
            "type" : "string"
          },
          "retryable" : {
            "type" : "boolean"
          }
        },
        "required" : [ "code", "message", "retryable" ]
      },
      "CheckResponse" : {
        "properties" : {
          "checkedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "errorCode" : {
            "enum" : [ "AUTH_FAILED", "PERMISSION_DENIED", "UNREACHABLE", "TLS_ERROR", "NOT_WOOCOMMERCE", "ADDRESS_NOT_ALLOWED", "UNEXPECTED_RESPONSE" ],
            "type" : "string"
          },
          "integration" : {
            "$ref" : "#/components/schemas/IntegrationResponse"
          },
          "sourceCurrency" : {
            "type" : "string"
          },
          "status" : {
            "enum" : [ "PENDING_CREDENTIALS", "CHECK_REQUIRED", "CONNECTED", "ERROR" ],
            "type" : "string"
          },
          "warnings" : {
            "items" : {
              "enum" : [ "CURRENCY_MISMATCH", "CURRENCY_UNKNOWN" ],
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "checkedAt", "integration", "status", "warnings" ],
        "type" : "object"
      },
      "CreateConnectionRequest" : {
        "properties" : {
          "provider" : {
            "enum" : [ "WOOCOMMERCE" ],
            "type" : "string"
          },
          "storeUrl" : {
            "example" : "https://shop.example.com",
            "type" : "string"
          }
        },
        "required" : [ "provider", "storeUrl" ],
        "type" : "object"
      },
      "FieldError" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field", "message" ]

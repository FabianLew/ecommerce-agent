{
  "components" : {
    "schemas" : {
      "ApiError" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "currentVersion" : {
            "type" : "string"
          },
          "fieldErrors" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            },
            "type" : "array"
          },
          "message" : {
            "type" : "string"
          },
          "requestId" : {
            "type" : "string"
          },
          "retryable" : {
            "type" : "boolean"
          }
        },
        "required" : [ "code", "message", "retryable" ]
      },
      "FieldError" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field", "message" ]
      },
      "ListResponseStoreResponse" : {
        "properties" : {
          "hasMore" : {
            "type" : "boolean"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/StoreResponse"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "required" : [ "hasMore", "items" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "userId" ],
        "type" : "object"
      },
      "StoreResponse" : {
        "properties" : {
          "currency" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "organizationId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "organizationName" : {
            "type" : "string"
          },
          "permissions" : {
            "items" : {
              "enum" : [ "STORE_READ", "STORE_MANAGE" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "roles" : {
            "items" : {
              "enum" : [ "OWNER", "DECISION_OPERATOR", "SUPPORT_OPERATOR", "ANALYST" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "storeId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "timezone" : {
            "type" : "string"
          }
        },
        "required" : [ "currency", "name", "organizationId", "organizationName", "permissions", "roles", "storeId", "timezone" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "Autonomous E-commerce Operator API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Missing or invalid access token"
          }
        },
        "tags" : [ "identity-controller" ]
      }
    },
    "/api/v1/stores" : {
      "get" : {
        "operationId" : "stores",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ListResponseStoreResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Missing or invalid access token"
          }
        },
        "tags" : [ "identity-controller" ]
      }
    },
    "/api/v1/stores/{storeId}" : {
      "get" : {
        "operationId" : "store",
        "parameters" : [ {
          "in" : "path",
          "name" : "storeId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StoreResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Missing or invalid access token"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Store member without the required permission"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Store or resource does not exist or is not available"
          }
        },
        "tags" : [ "identity-controller" ]
      }
    }
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "servers" : [ {
    "url" : "/"
  } ]
}

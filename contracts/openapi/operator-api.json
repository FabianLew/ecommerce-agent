          "variantsImported" : {
            "format" : "int32",
            "type" : "integer"
          },
          "windowFrom" : {
            "format" : "date-time",
            "type" : "string"
          },
          "windowUntil" : {
            "format" : "date-time",
            "type" : "string"
          }

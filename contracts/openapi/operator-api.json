          "provider" : {
            "enum" : [ "WOOCOMMERCE" ],
            "type" : "string"
          },
          "sourceCurrency" : {
            "type" : "string"
          },
          "status" : {
            "enum" : [ "PENDING_CREDENTIALS", "CHECK_REQUIRED", "CONNECTED", "ERROR" ],

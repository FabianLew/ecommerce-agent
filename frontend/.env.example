# Local development against infra/docker-compose.yml. Copy to .env.local.
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
OIDC_ISSUER=http://localhost:8180/realms/operator
OIDC_CLIENT_ID=operator-web
# Local-only secret from infra/keycloak/operator-realm.json. Real environments use a secret store.
OIDC_CLIENT_SECRET=local-operator-web-secret
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=local-development-session-secret-change-me-0000

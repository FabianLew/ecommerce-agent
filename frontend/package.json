{
  "name": "operator-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../contracts/openapi/operator-api.json -o src/api/schema.d.ts",
    "check:api": "pnpm generate:api && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "jose": "6.2.14",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.28.0"
}
